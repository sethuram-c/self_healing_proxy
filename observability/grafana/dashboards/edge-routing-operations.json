        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate({__name__=~\"shp[._]routing[._]latency[._]signal(_total)?\",used=\"true\"}[5m]))) / clamp_min((sum(rate({__name__=~\"shp[._]routing[._]decisions(_total)?\"}[5m]))), 1e-9)",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
