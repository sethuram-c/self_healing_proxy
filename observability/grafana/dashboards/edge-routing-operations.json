        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Fresh Latency Coverage",
      "description": "Fraction of routing decisions that used fresh latency evidence. Falling coverage means selection is degrading toward load-only evidence.",
      "datasource": {
