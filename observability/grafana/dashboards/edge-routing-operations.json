  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Routing Decision Rate",
      "description": "Observed routing-decision throughput from shp.routing.v1 metrics.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate({__name__=~\"shp[._]routing[._]decisions(_total)?\"}[5m]))",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Remote Routing Ratio",
      "description": "Fraction of decisions forced to the REMOTE tier. Rising values indicate local topology degradation or loss of safe local capacity.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate({__name__=~\"shp[._]routing[._]locality(_total)?\",tier=\"REMOTE\"}[5m]))) / clamp_min((sum(rate({__name__=~\"shp[._]routing[._]decisions(_total)?\"}[5m]))), 1e-9)",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Fallback Ratio",
      "description": "Fraction of decisions whose fallback reason is not NONE.",
      "datasource": {
        "type": "prometheus",
