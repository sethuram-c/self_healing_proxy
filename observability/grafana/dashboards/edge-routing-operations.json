      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate({__name__=~\"shp[._]routing[._]fallbacks(_total)?\",reason!=\"NONE\"}[5m]))) / clamp_min((sum(rate({__name__=~\"shp[._]routing[._]decisions(_total)?\"}[5m]))), 1e-9)",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
